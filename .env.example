# Daily Log — Environment Variables
# Copy file này thành .env và điền giá trị thực

# Gemini AI API Key (để AI tạo gợi ý nhật ký thực)
# Lấy tại: https://aistudio.google.com/app/apikey
# Nếu để trống, app sẽ dùng mock AI (template cố định)
EXPO_PUBLIC_GEMINI_API_KEY=

# RevenueCat API Keys (cho IAP - mua Premium)
# Tạo tại: https://app.revenuecat.com
# Nếu để trống, app dùng SimulatedPurchaseService (giả lập)
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
