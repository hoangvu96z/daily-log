        "NSMicrophoneUsageDescription": "Ứng dụng cần truy cập micro để bạn có thể ghi âm cảm xúc vào nhật ký."
      }
    },
    "android": {
      "package": "com.hoangvu96z.dailylog",
      "adaptiveIcon": {
        "backgroundColor": "#f7f0e6"
      }
    },
    "plugins": [
      "expo-av"
    ]
  }
}
